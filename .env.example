
# PostgreSQL source and rag schema
DATABASE_HOST=ec2-host-or-database-host
DATABASE_PORT=5432
DATABASE_NAME=clinical
DATABASE_USER=application_role
DATABASE_PASSWORD=replace-me
DATABASE_USE_SSH_TUNNEL=true
DATABASE_TUNNEL_LOCAL_PORT=55432

# AWS EC2 SSH tunnel
SSH_USER=ubuntu
SSH_KEY_PATH=Keys/health.pem
SSH_KNOWN_HOSTS_PATH=Keys/known_hosts

# Local model and application paths
GUARDRAILS_PATH=packages/core-rag/guardrails
WEB_ROOT=apps/web/src

# Gemini runtime generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Production identity provider
JWT_ISSUER=
JWT_AUDIENCE=doc-agent
JWT_JWKS_URL=
JWT_ALGORITHMS=RS256,ES256
JWT_PATIENT_IDS_CLAIM=patient_ids
JWT_DOCTOR_ID_CLAIM=sub
RECENT_PATIENT_HMAC_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=60

# Local development authentication; leave disabled in production
DEV_AUTH_ENABLED=false
DEV_AUTH_PUBLIC_URL=http://127.0.0.1:8001
DEV_AUTH_ISSUER=http://127.0.0.1:8001
DEV_AUTH_AUDIENCE=doc-agent
DEV_AUTH_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
DEV_AUTH_ALLOWED_ORIGIN=http://127.0.0.1:8000
DEV_AUTH_TOKEN_LIFETIME_SECONDS=3600

# API listener; localhost is the safe local default
API_HOST=127.0.0.1
API_PORT=8000
